{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Marketing",
  "version": "0.1.0",
  "identifier": "com.aimarketing.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @aimarketing/desktop dev",
    "beforeBuildCommand": "pnpm --filter @aimarketing/desktop build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "AI Marketing", "width": 1360, "height": 860, "minWidth": 1080, "minHeight": 720, "resizable": true }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'" }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "resources": ["../dist-runtime/host.mjs", "../dist-runtime/skills", "../dist-runtime/skill-catalog.json", "../dist-runtime/runtime", "../dist-runtime/install-desktop-runtime.ps1"],
    "targets": ["nsis"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
